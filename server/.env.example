# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/shop

# Use a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-value
JWT_EXPIRES_IN=7d

# The URL where the Next.js frontend runs (used for CORS)
CLIENT_ORIGIN=http://localhost:3000

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
